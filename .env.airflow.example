# 复制成 .env 再按需改：  cp .env.airflow.example .env
# （.env 已被仓库 .gitignore 排除；本示例文件本身**会**进仓库）
#
# docker compose 会自动读同目录下的 .env。什么都不设也能跑（有默认值）。

# 容器里跑 Airflow 的 uid。官方镜像里 `airflow` 用户就是 50000。
#   Linux 宿主：建议改成 `id -u`，否则宿主上的 .sandbox/ 属主对不上会 EACCES
#   Windows（Docker Desktop）：保持 50000 即可
AIRFLOW_UID=50000

# Fernet key —— 用来加密连接密码等凭据。留空也能跑（compose 里 `${FERNET_KEY:-}`），
# 但**认真用**就该生成一个固定的，否则每次重启换 key 会让已加密的凭据失效。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# 可选：切真机数据源/补依赖时用（fixture 模式不需要，留空即可）
_PIP_ADDITIONAL_REQUIREMENTS=
